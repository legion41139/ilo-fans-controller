<?php
/*
  [!] DO NOT EDIT THIS FILE [!]

  This file is used to get the
  iLO access credentials via
  environment variables.
  Used when deploying with Docker.
*/

$ILO_HOST = getenv('ILO_HOST');
$ILO_USERNAME = getenv('ILO_USERNAME');
$ILO_PASSWORD = getenv('ILO_PASSWORD');

$MINIMUM_FAN_SPEED = getenv('MINIMUM_FAN_SPEED') ?: 10; // Default to 10% if not provided

$AUTO_TEMP_THRESHOLD = getenv('AUTO_TEMP_THRESHOLD') !== false ? (int) getenv('AUTO_TEMP_THRESHOLD') : 50;
$AUTO_FAN_SPEED_COOL = getenv('AUTO_FAN_SPEED_COOL') !== false ? (int) getenv('AUTO_FAN_SPEED_COOL') : 15;
$AUTO_FAN_SPEED_WARM = getenv('AUTO_FAN_SPEED_WARM') !== false ? (int) getenv('AUTO_FAN_SPEED_WARM') : 25;
$AUTO_POLL_INTERVAL = getenv('AUTO_POLL_INTERVAL') !== false ? (int) getenv('AUTO_POLL_INTERVAL') : 30;

?>
